{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.{js,cjs,mjs,ts,cts,mts,json,jsonc}", "!**/archive/**"]
  },
  "formatter": {
    "useEditorconfig": true,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteProperties": "preserve"
    }
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "nursery": {
        "noFloatingPromises": "warn",
        "noJsRestrictedProperties": {
          "level": "error",
          "options": {
            "entries": [
              {
                "object": "Tracing",
                "property": "enable",
                "message": "Tracing.enable() is not allowed in tests"
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noFocusedTests": "warn",
        "noShadow": "error"
      }
    }
  }
}
