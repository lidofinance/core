{
  "name": "lido-on-ethereum",
  "version": "3.0.2",
  "description": "Lido on Ethereum is a liquid-staking protocol allowing anyone to earn staking rewards without locking ether or maintaining infrastructure",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "imports": {
    "#lib": "./lib/index.js",
    "#lib/protocol": "./lib/protocol/index.js",
    "#lib/protocol/helpers": "./lib/protocol/helpers/index.js",
    "#lib/*": "./lib/*",
    "#scripts/*": "./scripts/*",
    "#test/suite": "./test/suite/index.js",
    "#test/deploy": "./test/deploy/index.js",
    "#test/*": "./test/*"
  },
  "scripts": {
    "compile": "hardhat build",
    "cleanup": "hardhat clean",
    "lint:sol": "hardhat lint-solidity",
    "lint:sol:fix": "yarn lint:sol --fix",
    "lint:ts": "biome lint . --error-on-warnings",
    "lint:ts:fix": "biome lint . --write --error-on-warnings",
    "lint": "yarn lint:sol && yarn lint:ts",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "check": "yarn lint && yarn format && yarn typecheck",
    "test": "PARALLEL=true NODE_OPTIONS='--max-old-space-size=10240' hardhat test test/**/*.test.ts",
    "test:bls:blst": "SKIP_INTERFACES_CHECK=true SKIP_LINT_SOLIDITY=true hardhat test test/common/bls.blst.e2e.fuzz.test.ts",
    "test:solidity": "hardhat test solidity",
    "test:coverage": "FUZZ_PROFILE=coverage NODE_OPTIONS='--max-old-space-size=16384' hardhat test --coverage test/**/*.test.ts test/**/*.t.sol",
    "test:coverage:integration": "MODE=scratch INTEGRATION_WITH_CMv2=off SKIP_LINT_SOLIDITY=true SKIP_INTERFACES_CHECK=true SKIP_CONTRACT_SIZE=true hardhat test --coverage test/integration/**/*.ts",
    "test:coverage:full": "MODE=scratch INTEGRATION_WITH_CMv2=off SKIP_LINT_SOLIDITY=true SKIP_INTERFACES_CHECK=true SKIP_CONTRACT_SIZE=true hardhat test --coverage test/**/*.test.ts test/**/*.t.sol test/integration/**/*.ts",
    "test:sequential": "hardhat test test/**/*.test.ts --gas-stats",
    "test:trace": "hardhat test test/**/*.test.ts -vvv",
    "test:fulltrace": "hardhat test test/**/*.test.ts -vvvvv",
    "test:integration": "bash scripts/run-test-integration.sh",
    "test:integration:local": "RUN_NETWORK=local yarn test:integration",
    "test:integration:trace": "TRACE=trace yarn test:integration",
    "test:integration:fulltrace": "TRACE=fulltrace yarn test:integration",
    "test:integration:upgrade": "MODE=forking UPGRADE=true yarn test:integration",
    "test:integration:upgrade:local": "RUN_NETWORK=local yarn test:integration:upgrade",
    "test:integration:upgrade-template": "TEMPLATE_TEST=true yarn test:integration:upgrade",
    "test:integration:scratch": "MODE=scratch yarn test:integration",
    "test:integration:scratch:trace": "MODE=scratch yarn test:integration:trace",
    "test:integration:scratch:fulltrace": "MODE=scratch yarn test:integration:fulltrace",
    "test:integration:fork:local": "MODE=forking NETWORK=local yarn test:integration",
    "test:node:docker:fork": "MODE=forking bash scripts/run-fork-node-docker.sh",
    "test:node:docker:scratch": "MODE=scratch bash scripts/run-fork-node-docker.sh",
    "test:node:local:fork": "bash scripts/run-fork-node.sh",
    "scratch:deploy:localhost": "SKIP_INTERFACES_CHECK=true SKIP_CONTRACT_SIZE=true GENESIS_TIME=1639659600 GAS_PRIORITY_FEE=1 GAS_MAX_FEE=100 DEPLOYER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 MODE=scratch hardhat run scripts/scratch/scratch-deploy.ts --network localhost",
    "test:fork:pdg-validator": "MODE=forking hardhat test test/integration/vaults/scenario/pdg-specific-validator.integration.ts --gas-stats",
    "validate:configs": "yarn hardhat validate-configs",
    "typecheck": "tsc --noEmit",
    "abis:extract": "hardhat abis:extract",
    "verify:deployed": "hardhat verify:deployed",
    "upgrade:fork-node": "yarn test:node:local:fork",
    "upgrade:mock:voting": "MODE=forking STEPS_FILE=upgrade/steps-mock-voting.json yarn deploy:upgrade",
    "deploy:helper:run": "bash scripts/dao-deploy.sh",
    "deploy:scratch": "MODE=scratch yarn deploy:helper:run",
    "deploy:scratch:local": "NETWORK=local yarn deploy:scratch",
    "deploy:upgrade": "UPGRADE=true yarn deploy:helper:run",
    "postinstall": "husky"
  },
  "lint-staged": {
    "./**/*.{js,cjs,mjs,ts,cts,mts,json,jsonc}": [
      "biome check --write --assist-enabled=false --no-errors-on-unmatched --error-on-warnings"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@chainsafe/blst": "2.2.0",
    "@chainsafe/ssz": "1.2.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@iarna/toml": "^2.2.5",
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.0.13",
    "@nomicfoundation/hardhat-mocha": "3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@nomicfoundation/hardhat-typechain": "3.1.1",
    "@nomicfoundation/hardhat-utils": "4.1.8",
    "@nomicfoundation/hardhat-verify": "3.0.22",
    "@nomicfoundation/ignition-core": "3.1.9",
    "@openzeppelin/merkle-tree": "1.0.8",
    "@solidstate/hardhat-contract-sizer": "3.0.3",
    "@types/chai-as-promised": "8.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.3",
    "bigint-conversion": "2.4.3",
    "chai": "5.3.3",
    "chalk": "4.1.2",
    "dotenv": "16.5.0",
    "ethereumjs-util": "7.1.5",
    "ethers": "6.16.0",
    "forge-std": "foundry-rs/forge-std#v1.9.4",
    "glob": "11.1.0",
    "hardhat": "3.15.0",
    "hardhat-ignore-warnings": "0.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.0",
    "mocha": "11.7.5",
    "solhint": "5.1.0",
    "solhint-plugin-lido": "0.0.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aragon/apps-agent": "2.1.0",
    "@aragon/apps-finance": "3.0.0",
    "@aragon/apps-lido": "https://github.com/lidofinance/aragon-apps/archive/refs/tags/app-voting-v3.0.0-1.tar.gz",
    "@aragon/apps-vault": "4.1.0",
    "@aragon/id": "2.1.1",
    "@aragon/minime": "1.0.0",
    "@aragon/os": "4.4.0",
    "@openzeppelin/contracts": "3.4.0",
    "@openzeppelin/contracts-v4.4": "npm:@openzeppelin/contracts@4.4.1",
    "@openzeppelin/contracts-v5.2": "npm:@openzeppelin/contracts@5.2.0",
    "openzeppelin-solidity": "2.0.0",
    "zod": "^4.0.13"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "keccak": {
      "built": true
    },
    "secp256k1": {
      "built": true
    }
  }
}
