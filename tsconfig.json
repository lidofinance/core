{
  "compilerOptions": {
    "target": "es2022",
    "module": "node20",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "mocha", "chai-as-promised"],
    "paths": {
      "*": ["./*"]
